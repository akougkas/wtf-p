{
  "schema": "wtfp.action/v1",
  "id": "analyze-bib",
  "title": "Analyze the bibliography",
  "description": "Analyze a bibliography and map its evidence to the paper's sections and claims.",
  "alias": "wtfp:analyze-bib",
  "surface": {
    "kind": "skill",
    "skill": "wtfp-research-literature"
  },
  "workflow": "wtfp://workflows/analyze-bib",
  "requirements": {
    "capabilities": [
      "agent.delegate",
      "filesystem.read",
      "filesystem.write",
      "network.search",
      "tool.execute",
      "user.interaction"
    ],
    "conditions": [
      "A readable bibliography is available"
    ]
  },
  "reads": [
    "project://manifest",
    "project://structure/outline",
    "project://sections/{section}",
    "project://sources/{source}",
    "project://evidence/{evidence}",
    "project://materials/{artifact}",
    "project://paper/{artifact}"
  ],
  "produces": [
    {
      "uri": "project://sources/{source}",
      "mode": "create"
    },
    {
      "uri": "project://sources/{source}",
      "mode": "update"
    },
    {
      "uri": "project://evidence/{evidence}",
      "mode": "create"
    },
    {
      "uri": "project://evidence/{evidence}",
      "mode": "update"
    },
    {
      "uri": "project://validations/{validation}",
      "mode": "create"
    }
  ],
  "delegation": [
    {
      "role": "citation-expert",
      "mode": "required",
      "purpose": "Map sources, intellectual lineages, and citation strategy to the manuscript"
    }
  ],
  "tools": [
    "bibliography.analyze-impact",
    "bibliography.index"
  ],
  "effects": [
    {
      "id": "agent.delegate",
      "scope": "role://citation-expert"
    },
    {
      "id": "filesystem.create",
      "scope": "project://sources/{source}, project://evidence/{evidence}, project://validations/{validation}"
    },
    {
      "id": "filesystem.modify",
      "scope": "project://sources/{source}, project://evidence/{evidence}"
    },
    {
      "id": "filesystem.read",
      "scope": "project://manifest, project://structure/outline, project://sections/{section}, project://sources/{source}, project://evidence/{evidence}, project://materials/{artifact}, project://paper/{artifact}"
    },
    {
      "id": "network.search",
      "scope": "declared scholarly index used by bibliography.analyze-impact"
    },
    {
      "id": "tool.execute",
      "scope": "wtfp://tools/bibliography/**"
    },
    {
      "id": "user.gate",
      "scope": "the provider and bounded query set for external citation-metric enrichment"
    }
  ]
}
