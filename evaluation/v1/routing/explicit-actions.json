{
  "schema": "wtfp.evaluation.explicit-actions/v1",
  "version": 1,
  "disclosure_policy": {
    "skill": "protocol/skills/{skill}/SKILL.md for academic actions; none for product operations",
    "action_reference": "protocol/skills/{skill}/references/actions.md is one monolithic skill reference; none for product operations",
    "action_contract": "protocol/actions/{action}.json",
    "workflow": "protocol/workflows/{action}.md",
    "project_records": "common plus only schemas/templates derived from the selected action reads and outputs",
    "observability": "record loaded, not-loaded, or unobservable per resource; never infer a load from routing success"
  },
  "actions": [
