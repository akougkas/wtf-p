{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtfp.evaluation.semantic-rubric/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "score_range", "statuses", "dimensions"],
  "properties": {
    "schema": { "const": "wtfp.evaluation.semantic-rubric/v1" },
    "version": { "const": 1 },
    "score_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "const": 0 },
        "maximum": { "const": 1 }
      }
    },
    "statuses": {
      "type": "array",
      "items": { "enum": ["pass", "warning", "fail", "capability-unavailable"] },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "dimensions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "measurement", "description", "pass_condition", "failure_signal", "anchors"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "class": { "enum": ["structural", "safety", "semantic"] },
          "measurement": { "enum": ["boolean", "normalized-score", "rate"] },
          "description": { "type": "string", "minLength": 12 },
          "pass_condition": { "type": "string", "minLength": 12 },
          "failure_signal": { "type": "string", "minLength": 12 },
          "scope_limitation": { "type": "string", "minLength": 24 },
          "raw_metric": { "type": "string", "minLength": 8 },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "weight", "criterion", "evidence_kind"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
                "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "criterion": { "type": "string", "minLength": 12 },
                "evidence_kind": {
                  "enum": ["deterministic-check", "independent-semantic-review", "hybrid"]
                }
              }
            }
          }
        }
      }
    }
  }
}
