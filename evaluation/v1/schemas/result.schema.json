{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtfp.evaluation.result/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "outcome", "run", "scenario", "capabilities", "invariants", "cost", "latency_ms"],
  "properties": {
    "schema": { "const": "wtfp.evaluation.result/v1" },
    "outcome": { "enum": ["completed", "blocked", "capability-unavailable"] },
    "run": { "$ref": "wtfp.evaluation.run-metadata/v1" },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phases_exercised", "oracle_sha256", "action_sequence", "process_boundaries"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "phases_exercised": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["new-paper", "lifecycle", "resume"] },
          "uniqueItems": true
        },
        "oracle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "action_sequence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
        },
        "process_boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after_action", "fresh_process", "evidence"],
            "properties": {
              "after_action": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
              "fresh_process": { "type": "boolean" },
              "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
          "status": { "enum": ["available", "unavailable", "not-applicable"] },
          "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "output": { "$ref": "#/$defs/output" },
    "cost": { "$ref": "#/$defs/cost" },
    "latency_ms": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "completed" } } },
      "then": { "required": ["artifacts", "output"] },
      "else": { "not": { "required": ["output"] } }
    }
  ],
  "$defs": {
    "cost": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "amount", "currency", "source", "evidence"],
          "properties": {
            "status": { "enum": ["metered", "estimated", "unavailable"] },
            "amount": { "type": ["number", "null"], "minimum": 0 },
            "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
            "source": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "unavailable" } } },
              "then": { "properties": { "amount": { "const": null }, "currency": { "const": null } } },
              "else": {
                "properties": {
                  "amount": { "type": "number", "minimum": 0 },
                  "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
                }
              }
            }
          ]
        }
      ]
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earned_points", "possible_points", "anchors"],
      "properties": {
        "earned_points": { "type": "number", "minimum": 0 },
        "possible_points": { "type": "number", "exclusiveMinimum": 0 },
        "observed_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 1 },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "weight", "verdict", "earned_points", "observation"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
              "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "verdict": { "enum": ["pass", "warning", "fail", "capability-unavailable"] },
              "earned_points": { "type": "number", "minimum": 0 },
              "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "evidence_sha256s": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "uniqueItems": true
              },
              "observation": { "type": "string", "minLength": 8 }
            },
            "oneOf": [
              { "required": ["evidence_sha256"] },
              { "required": ["evidence_sha256s"] }
            ]
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "phases", "status", "score", "scoring", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "class": { "enum": ["structural", "safety", "semantic"] },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["always", "new-paper", "lifecycle", "resume"] },
          "uniqueItems": true
        },
        "status": { "enum": ["pass", "warning", "fail", "capability-unavailable"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "observed_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "scoring": { "$ref": "#/$defs/scoring" },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planning", "schema_validation", "vcs", "profiles", "credentials"],
      "properties": {
        "planning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["records_observed", "records_produced", "evidence"],
          "properties": {
            "records_observed": { "type": "integer", "minimum": 1 },
            "records_produced": { "type": "integer", "minimum": 1 },
            "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
          }
        },
        "schema_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checked", "valid", "invalid", "evidence"],
          "properties": {
            "checked": { "type": "integer", "minimum": 1 },
            "valid": { "type": "integer", "minimum": 0 },
            "invalid": { "type": "integer", "minimum": 0 },
            "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
          }
        },
        "vcs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_sha256", "after_sha256", "unchanged", "evidence"],
          "properties": {
            "before_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "after_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "unchanged": { "type": "boolean" },
            "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unchanged", "evidence"],
          "properties": {
            "unchanged": { "type": "boolean" },
            "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forwarded", "cleanup_status", "evidence"],
          "properties": {
            "forwarded": { "type": "boolean" },
            "cleanup_status": { "enum": ["not-forwarded", "securely-removed", "cleanup-failed"] },
            "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256", "semantic_units", "evidence"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "semantic_units": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
      }
    }
  }
}
