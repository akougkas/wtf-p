{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtfp.evaluation.fixture-hashes/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture_id",
    "fixture_version",
    "hash_algorithm",
    "model_inputs_sha256",
    "evaluator_oracles_sha256",
    "aggregate_sha256",
    "files"
  ],
  "properties": {
    "schema": { "const": "wtfp.evaluation.fixture-hashes/v1" },
    "fixture_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "fixture_version": { "type": "integer", "minimum": 1 },
    "hash_algorithm": { "const": "sha256" },
    "model_inputs_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluator_oracles_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "aggregate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "audience"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "audience": { "enum": ["model", "evaluator", "harness"] }
        }
      }
    }
  }
}
