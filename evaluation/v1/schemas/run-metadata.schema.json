{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtfp.evaluation.run-metadata/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "started_at",
    "evidence_level",
    "client",
    "model",
    "effort",
    "permission_policy",
    "protocol",
    "fixture",
    "execution",
    "profile_hashes",
    "case_isolation"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "started_at": { "type": "string", "format": "date-time" },
    "evidence_level": { "enum": ["static-lint", "native-discovery", "paid-model"] },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requested_version", "actual_version", "binary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "requested_version": { "type": "string", "minLength": 1 },
        "actual_version": { "type": "string", "minLength": 1 },
        "binary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "requested_id", "actual_id", "requested_version", "actual_version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "requested_id": { "type": "string", "minLength": 1 },
        "actual_id": { "type": "string", "minLength": 1 },
        "requested_version": { "type": "string", "minLength": 1 },
        "actual_version": { "type": "string", "minLength": 1 }
      }
    },
    "effort": { "type": "string", "minLength": 1 },
    "effective_effort": { "type": "string", "minLength": 1 },
    "identity_evidence": { "$ref": "#/$defs/evidence" },
    "permission_policy": { "type": "string", "minLength": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_protocol_version",
        "adapter_compiler_version",
        "wtfp_commit",
        "client_commit",
        "source_sha256"
      ],
      "properties": {
        "project_protocol_version": { "const": 1 },
        "adapter_compiler_version": { "type": "integer", "minimum": 1 },
        "wtfp_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "client_commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "fixture": { "$ref": "#/$defs/fixture" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "command_sha256", "environment_policy"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "command_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "environment_policy": { "type": "string", "minLength": 1 }
      }
    },
    "profile_hashes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile-hash-pair" }
    },
    "case_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "session_ids_unique", "conversational_memory_shared", "evidence"],
      "properties": {
        "strategy": {
          "enum": ["fresh-process-per-case", "fresh-session-per-case", "single-scenario-session"]
        },
        "session_ids_unique": { "type": "boolean" },
        "conversational_memory_shared": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "matrix_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_id", "matrix_version", "row_id", "sha256"],
      "properties": {
        "matrix_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "matrix_version": { "type": "integer", "minimum": 1 },
        "row_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "model_inputs_sha256",
        "evaluator_oracles_sha256",
        "aggregate_sha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "integer", "minimum": 1 },
        "model_inputs_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evaluator_oracles_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "aggregate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "profile-hash-pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "before_sha256", "after_sha256", "unchanged"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "before_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "unchanged": { "type": "boolean" }
      }
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "enum": ["independent-tool", "human", "model", "static-analysis"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "relationship": { "enum": ["candidate", "independent-evaluator"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256", "assessor", "summary"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assessor": { "$ref": "#/$defs/assessor" },
        "summary": { "type": "string", "minLength": 1 },
        "method": { "enum": ["deterministic-check", "independent-semantic-review"] }
      }
    }
  }
}
