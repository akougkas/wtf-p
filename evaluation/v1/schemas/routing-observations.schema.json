{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtfp.evaluation.routing-observations/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite", "run", "observations", "cost", "latency_ms"],
  "properties": {
    "schema": { "const": "wtfp.evaluation.routing-observations/v1" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest_sha256", "target", "selector_profile"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "integer", "minimum": 1 },
        "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "selector_profile": { "enum": ["claude", "codex", "clio"] }
      }
    },
    "run": { "$ref": "wtfp.evaluation.run-metadata/v1" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "session_id",
          "input_sha256",
          "project_snapshot_sha256",
          "selector",
          "route",
          "activation",
          "disclosure",
          "arguments",
          "cost",
          "latency_ms",
          "evidence"
        ],
        "properties": {
          "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "session_id": { "type": "string", "minLength": 1 },
          "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "project_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "selector": { "$ref": "#/$defs/selector-observation" },
          "route": { "$ref": "#/$defs/route-observation" },
          "activation": { "$ref": "#/$defs/activation-observation" },
          "disclosure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "resources", "capabilities", "evidence"],
            "properties": {
              "status": { "enum": ["observed", "partially-observed", "unobservable"] },
              "resources": {
                "type": "array",
                "items": { "$ref": "#/$defs/resource-observation" }
              },
              "capabilities": {
                "type": "array",
                "items": { "$ref": "#/$defs/capability-observation" }
              },
              "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
            }
          },
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "value", "evidence"],
            "properties": {
              "status": { "enum": ["observed", "ordinary-prose", "unobservable", "not-applicable"] },
              "value": { "type": ["string", "null"] },
              "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
            }
          },
          "cost": { "$ref": "#/$defs/cost" },
          "latency_ms": { "type": "integer", "minimum": 0 },
          "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
        }
      }
    },
    "cost": { "$ref": "#/$defs/aggregate-cost" },
    "latency_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "route": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "skill", "action"],
          "properties": {
            "kind": { "const": "skill" },
            "skill": { "type": "string", "pattern": "^wtfp-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
            "action": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action"],
          "properties": {
            "kind": { "const": "operation" },
            "action": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
          }
        }
      ]
    },
    "selector-observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["accepted", "rejected", "unsupported", "not-applicable", "unobservable"] },
        "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
      }
    },
    "route-observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "granularity", "value", "evidence"],
      "properties": {
        "signal": { "enum": ["selected", "suggested", "none", "unobservable"] },
        "granularity": { "enum": ["action", "skill", "none", "unobservable"] },
        "value": { "oneOf": [{ "$ref": "#/$defs/route" }, { "type": "null" }] },
        "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
      }
    },
    "activation-observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "skill", "evidence"],
      "properties": {
        "status": { "enum": ["loaded", "not-loaded", "not-applicable", "unobservable"] },
        "skill": {
          "type": ["string", "null"],
          "pattern": "^wtfp-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
      }
    },
    "resource-observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "status", "evidence"],
      "properties": {
        "kind": { "enum": ["skill", "action-reference", "action-contract", "workflow", "schema", "template"] },
        "path": {
          "type": "string",
          "pattern": "^protocol/(?:skills|actions|workflows|project/schemas|project/templates)/[A-Za-z0-9._/-]+$"
        },
        "status": { "enum": ["loaded", "not-loaded", "unobservable"] },
        "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
      }
    },
    "capability-observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
        "status": { "enum": ["available", "unavailable", "unobservable"] },
        "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "amount", "currency", "source", "evidence"],
      "properties": {
        "status": { "enum": ["metered", "estimated", "unavailable"] },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "source": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": { "properties": { "amount": { "const": null }, "currency": { "const": null } } },
          "else": {
            "properties": {
              "amount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
            }
          }
        }
      ]
    },
    "aggregate-cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "amount", "currency", "source", "evidence", "priced_cases", "unpriced_cases"],
      "properties": {
        "status": { "enum": ["metered", "estimated", "unavailable"] },
        "amount": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "source": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "wtfp.evaluation.run-metadata/v1#/$defs/evidence" },
        "priced_cases": { "type": "integer", "minimum": 0 },
        "unpriced_cases": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "unavailable" } } },
          "then": { "properties": { "amount": { "const": null }, "currency": { "const": null } } },
          "else": {
            "properties": {
              "amount": { "type": "number", "minimum": 0 },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
            }
          }
        }
      ]
    }
  }
}
