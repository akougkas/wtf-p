{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wtfp.effects/v1",
  "title": "WTF-P semantic effect registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "effects"],
  "properties": {
    "schema": { "const": "wtfp.effects/v1" },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "consent", "reversibility"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
          "description": { "type": "string", "minLength": 1 },
          "consent": { "enum": ["none", "implicit", "explicit"] },
          "reversibility": { "enum": ["reversible", "conditionally-reversible", "irreversible", "not-applicable"] }
        }
      }
    }
  }
}
