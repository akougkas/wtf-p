{
  "schema": "wtfp.action/v1",
  "id": "map-project",
  "title": "Map an existing project",
  "description": "Index existing drafts, data, figures, and references into portable project state.",
  "alias": "wtfp:map-project",
  "surface": {
    "kind": "skill",
    "skill": "wtfp-start-project"
  },
  "workflow": "wtfp://workflows/map-project",
  "requirements": {
    "capabilities": [
      "filesystem.read",
      "filesystem.write"
    ],
    "conditions": [
      "The project contains material to inventory"
    ]
  },
  "reads": [
    "project://manifest",
    "project://state",
    "project://materials/{artifact}",
    "project://paper/{artifact}"
  ],
  "produces": [
    {
      "uri": "project://sources/{source}",
      "mode": "create"
    },
    {
      "uri": "project://evidence/{evidence}",
      "mode": "create"
    },
    {
      "uri": "project://state",
      "mode": "update"
    }
  ],
  "delegation": [],
  "tools": [],
  "effects": [
    {
      "id": "filesystem.create",
      "scope": "project://sources/{source}, project://evidence/{evidence}"
    },
    {
      "id": "filesystem.read",
      "scope": "project://manifest, project://state, project://materials/{artifact}, project://paper/{artifact}"
    },
    {
      "id": "filesystem.write",
      "scope": "project://sources/{source}, project://evidence/{evidence}, project://state"
    }
  ]
}
